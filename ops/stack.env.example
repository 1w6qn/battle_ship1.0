# Copy to /etc/battleship/stack.env and make systemd read it:
#   EnvironmentFile=/etc/battleship/stack.env
# The only switch knob is BACKEND_STACK (legacy | rewrite).
BACKEND_STACK=rewrite

# Where the read-only legacy checkout lives (needed only by stack=legacy).
LEGACY_WORKTREE=/opt/battleship-legacy

# Same variables the old stack already used.
# Migration window: legacy = old SPA at /, spa = built Vue shell (#21).
FRONTEND_MODE=legacy

PORT=5000
HOST=0.0.0.0
BATTLESHIP_DB_PATH=/var/lib/battleship/battleship.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=https://example.invalid
TURN_TIMEOUT_SECONDS=90
CHAIN_DISPLAY_DELAY_SECONDS=1.2
ENABLE_TEST_EVENTS=0
